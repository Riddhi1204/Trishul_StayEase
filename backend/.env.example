# Environment — copy to .env and fill in values
# Never commit .env to source control

# ── Server ────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

# ── CORS — comma-separated list of allowed origins ────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://trishul-stay-ease.vercel.app

# ── MongoDB Atlas ─────────────────────────────────────────────────
# Get your connection string from: Atlas → Connect → Drivers → Python
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Name of the MongoDB database (created automatically on first use)
DB_NAME=trishul_stayease
