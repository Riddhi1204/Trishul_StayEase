# Environment — copy to .env and fill in values
# Never commit .env to source control

# ── Server ────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

# ── CORS — comma-separated list of allowed origins ────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://trishul-stay-ease.vercel.app

# ── MongoDB Atlas ─────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=trishul_stayease

# ── JWT Authentication ────────────────────────────────────────────
# Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))"
# Add this same value to Render environment variables for production
JWT_SECRET=your-super-secret-key-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
JWT_REFRESH_EXPIRE_DAYS=30

# ── Google OAuth ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
