# ── Local Development ──
# Uncomment the line below to connect the frontend to your local FastAPI backend.
# VITE_API_URL=http://localhost:8000

# ── Production (Vercel) ──
# When deploying to Vercel, add VITE_API_URL in the Vercel Project Settings -> Environment Variables.
# The value should be your live Render backend URL.
# Example:
# VITE_API_URL=https://trishul-stayease-api.onrender.com
